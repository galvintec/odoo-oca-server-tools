<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook[1]">
                <page
                    name="custom_info"
                    string="Custom Information"
                    groups="base_custom_info.group_partner"
                >
                    <group>
                        <group>
                            <field
                                name="custom_info_template_id"
                                options='{"no_quick_create": True}'
                            />
                        </group>
                        <!--<field
                            name="custom_info_ids"
                            colspan="4"
                            nolabel="1"
                        />-->
                        <!--mode="custom_info"-->
                        <!--widget="custom_info"-->
                        <field name="custom_info_ids">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="field_type" invisible="true"/>
                                <field name="category_id" readonly="true"/>
                                <field name="property_id" readonly="true"/>
                                <field name="value" attrs="{'readonly': [('field_type','=','id')]}"/>
                                <field name="value_id" attrs="{'readonly': [('field_type','!=','id')]}"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
